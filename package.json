{
  "scripts": {
    "start": "tsx watch --env-file=.env src/bootstrap.ts",
    "prod": "node --env-file=.env dist/bootstrap.js",
    "services-up": "docker compose --env-file .env -p docx_services -f docker/docker-compose.services.yml up -d",
    "services-down": "docker compose --env-file .env -p docx_services -f docker/docker-compose.services.yml down",
    "start:deploy:build": "docker compose --env-file .env -p docx_services -f docker/docker-compose.deploy.yml up --build -d",
    "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "deploy": "npm run services-up && npm run start:deploy:build",
    "check:build": "git pull origin main && npm install && npx tsc -noEmit"
  },
  "engines": {
    "node": "22"
  },
  "main": "dist/bootstrap.js",
  "dependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^22.13.4",
    "amqplib": "^0.10.5",
    "axios": "^1.8.1",
    "bcrypt": "^5.1.1",
    "connect-timeout": "^1.9.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "form-data": "^4.0.2",
    "io-logger": "^1.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "multer": "^1.4.5-lts.1",
    "tsc-alias": "^1.8.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/connect-timeout": "^0.0.39",
    "@types/cors": "^2.8.17",
    "@types/multer": "^1.4.12"
  }
}